# Telegram API credentials (from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Pyrogram string session for the Assistant user account that joins voice chats
STRING_SESSION=your_pyrogram_string_session_here

# Owner Telegram user ID(s), comma-separated
OWNER_IDS=123456789

# Optional log group/channel ID (e.g. -1001234567890)
LOG_CHAT_ID=

# Bot branding & defaults
BOT_NAME=Nat Music
SUPPORT_CHAT=https://t.me/YourSupportGroup
UPDATES_CHANNEL=https://t.me/YourUpdatesChannel

# Persistence: defaults to local SQLite (nat_music.db). Set MONGO_URL to use MongoDB instead.
SQLITE_PATH=nat_music.db
MONGO_URL=

# Playback limits & behavior
DURATION_LIMIT_MIN=180
DEFAULT_VOLUME=100
AUTO_LEAVE_MINUTES=10
VOTE_SKIP_THRESHOLD=3
USE_THUMBNAIL_CARDS=true
